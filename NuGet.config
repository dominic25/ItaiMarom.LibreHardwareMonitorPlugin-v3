<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Empty in a fresh clone. `dotnet pack` the Macro Deck SDK into it to build against an
             unreleased version. -->
        <add key="local" value="./local-feed" />
    </packageSources>
</configuration>
