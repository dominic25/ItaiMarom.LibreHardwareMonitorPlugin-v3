<?xml version="1.0" encoding="utf-8"?>
<root>
  <!-- The default-language file. Every translation is checked against it and the fallback chain ends
       here, so it is required even for a plugin that ships one language. Add a language by adding
       Localization/Strings.<culture>.resx beside it (Strings.de.resx, Strings.pt-BR.resx).
       A dotted key becomes a nested class: Plugin.Name is Strings.Plugin.Name(). -->
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <data name="Plugin.Name" xml:space="preserve">
    <value>Libre Hardware Monitor</value>
  </data>
  <data name="Plugin.Description" xml:space="preserve">
    <value>Reads hardware sensors and exposes them as Macro Deck variables.</value>
  </data>
  <data name="Configuration.Title" xml:space="preserve">
    <value>Libre Hardware Monitor</value>
  </data>
  <data name="Configuration.Description" xml:space="preserve">
    <value>Pick the sensors to publish as variables, and how often to read them. Sensors you leave out stay available from the variable catalog.</value>
  </data>
  <data name="Configuration.Sensors" xml:space="preserve">
    <value>Sensors</value>
  </data>
  <data name="Configuration.SensorsHint" xml:space="preserve">
    <value>Every sensor you pick becomes a variable of its own. The names the Macro Deck 2 plugin used are kept, so an upgraded button keeps working.</value>
  </data>
  <data name="Configuration.PollingRate" xml:space="preserve">
    <value>Update interval (ms)</value>
  </data>
  <data name="Configuration.PollingRateHint" xml:space="preserve">
    <value>How often the sensors are read, from 10 to 10000 milliseconds.</value>
  </data>
  <data name="Configuration.UnknownStep" xml:space="preserve">
    <value>Unknown step.</value>
  </data>
</root>
