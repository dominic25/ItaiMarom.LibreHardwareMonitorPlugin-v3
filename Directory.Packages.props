<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <!-- One knob for every Macro Deck package. The Macro Deck 3 SDK is still prerelease and its
             surface moves between builds, so the version is pinned to an exact build for reproducible
             plugin releases. Override it for a one-off build against a locally packed SDK:
             `dotnet build -p:MacroDeckSdkVersion=<version>`. -->
        <MacroDeckSdkVersion Condition="'$(MacroDeckSdkVersion)' == ''">3.0.0-preview.10</MacroDeckSdkVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="MacroDeck.Localization" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Plugin.Analyzers" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Plugin.Hosting" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Plugin.Serilog" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Plugin.Testing" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Sdk" Version="$(MacroDeckSdkVersion)" />
        <!-- The declarative UI model (config flows, settings views). Referenced from the project in
             the UI step. -->
        <PackageVersion Include="MacroDeck.Ui" Version="$(MacroDeckSdkVersion)" />
        <PackageVersion Include="MacroDeck.Ui.Testing" Version="$(MacroDeckSdkVersion)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The hardware layer. LibreHardwareMonitorLib 0.9.6 ships a net10.0 target group, so it is
             consumed directly instead of the Macro Deck 2 reflection dance around a helper assembly. -->
        <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
        <PackageVersion Include="NUnit" Version="4.3.2" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.7.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    </ItemGroup>

</Project>
